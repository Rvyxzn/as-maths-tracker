# Examiner report PDFs (~90 MB). Their text lives in js/eco-examiner-reports.js,
# which is what the app actually reads. Safe to delete the folder; the exact
# Pearson URLs are recorded in that file's header if they are ever needed again.
Exam questions PDFs/A-Level Economics/Examiner Reports/
.tmpwork/

# Supabase local state. `link` and `deploy` write a project ref and a
# pooler URL in here; none of it belongs in a public repo, and an
# .env holding the API key REALLY does not.
supabase/.temp/
supabase/.branches/
.env
.env.*
